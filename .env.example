# Required: Your Gemini Developer API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Block 1: Speech-to-Text (Gemini Live API Streaming Transcription - requires 16kHz PCM)
# Docs: https://ai.google.dev/gemini-api/docs/live-api/live-transcribe
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
GEMINI_STT_MODE=SMART

# Block 2: Large Language Model (Low-Latency Streaming Q&A)
# Docs: https://ai.google.dev/gemini-api/docs/models/gemini-3.5-flash-lite
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_LLM_THINKING_LEVEL=minimal

# Block 3: Text-to-Speech (Low-Latency Streaming Speech Synthesis - native 24kHz PCM)
# Docs: https://ai.google.dev/gemini-api/docs/models/gemini-3.8-flash-lite-tts
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_STYLE=Warm, clear, natural conversational voice at a brisk, helpful pace.

# 8kHz Telephony / Dialer Converter Settings (Twilio, Exotel, Plivo, Telnyx, SIP /ws-dialer)
# TELEPHONY_8K_ENABLED: upsamples 8kHz dialer input -> 16kHz STT and downsamples 24kHz TTS -> 8kHz dialer
TELEPHONY_8K_ENABLED=true
DIALER_SAMPLE_RATE=8000
# DIALER_ENCODING: "ulaw" (G.711 mu-law / PCMU), "alaw" (G.711 A-law / PCMA), or "pcm16" (16-bit linear PCM)
DIALER_ENCODING=ulaw

# Optional Telephony Provider REST Credentials (only required for automatic REST call hangup)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TELNYX_API_KEY=

# VAD & Turn Detection Tuning
# VAD_STOP_SECS: silence window (seconds) before Silero VAD marks speech stopped (default 0.2s)
VAD_STOP_SECS=0.2
# TURN_STOP_MODE: "smart_turn" (LocalSmartTurnAnalyzerV3 ONNX) or "vad" (pure VAD + STT finalization)
TURN_STOP_MODE=smart_turn
# GREET_ON_CONNECT: whether the bot speaks a brief greeting when a client/dialer connects
GREET_ON_CONNECT=true
